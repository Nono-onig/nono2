<div class="profile-edit-page">

  <!-- =========================
       タイトル
  ========================== -->

  <div class="profile-edit-heading">

    <p class="profile-edit-mini-title">
      Edit Profile ✎
    </p>

    <h1>
      プロフィール編集
    </h1>

    <p class="profile-edit-subtitle">
      あなたのプロフィールを更新しよう ❤︎
    </p>

  </div>


  <!-- =========================
       編集フォーム
  ========================== -->

  <div class="profile-edit-card">

    <%= form_for(
      resource,
      as: resource_name,
      url: registration_path(resource_name),
      html: { method: :put }
    ) do |f| %>

      <%= render "users/shared/error_messages", resource: resource %>


      <!-- 名前 -->

      <div class="profile-edit-field">

        <%= f.label :name, "👤 名前" %>

        <%= f.text_field :name,
          autofocus: true,
          autocomplete: "name",
          class: "profile-edit-input",
          placeholder: "名前を入力"
        %>

      </div>


      <!-- プロフィール -->

      <div class="profile-edit-field">

        <%= f.label :profile, "💬 プロフィール" %>

        <%= f.text_area :profile,
          class: "profile-edit-textarea",
          placeholder: "自己紹介や好きな旅について書いてみよう..."
        %>

      </div>


      <!-- メールアドレス -->

      <div class="profile-edit-field">

        <%= f.label :email, "✉️ メールアドレス" %>

        <%= f.email_field :email,
          autocomplete: "email",
          class: "profile-edit-input",
          placeholder: "example@email.com"
        %>

      </div>


      <!-- メールアドレス確認待ち -->

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>

        <div class="profile-edit-confirmation">

          現在、以下のメールアドレスの確認待ちです。

          <strong>
            <%= resource.unconfirmed_email %>
          </strong>

        </div>

      <% end %>


      <!-- 新しいパスワード -->

      <div class="profile-edit-field">

        <%= f.label :password, "🔑 新しいパスワード" %>

        <p class="profile-edit-note">
          パスワードを変更しない場合は空欄のままでOKです
        </p>

        <% if @minimum_password_length %>

          <p class="profile-edit-note">
            <%= @minimum_password_length %>文字以上で入力してください
          </p>

        <% end %>

        <%= f.password_field :password,
          autocomplete: "new-password",
          class: "profile-edit-input",
          placeholder: "新しいパスワード"
        %>

      </div>


      <!-- パスワード確認 -->

      <div class="profile-edit-field">

        <%= f.label :password_confirmation, "🔐 新しいパスワード確認" %>

        <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          class: "profile-edit-input",
          placeholder: "もう一度入力してください"
        %>

      </div>


      <!-- 現在のパスワード -->

      <div class="profile-edit-field">

        <%= f.label :current_password, "🔒 現在のパスワード" %>

        <p class="profile-edit-note">
          変更内容を保存するために、現在のパスワードを入力してください
        </p>

        <%= f.password_field :current_password,
          autocomplete: "current-password",
          class: "profile-edit-input",
          placeholder: "現在のパスワード"
        %>

      </div>


      <!-- 更新 -->

      <div class="profile-edit-actions">

        <%= f.submit "更新する ✈︎",
          class: "profile-edit-submit"
        %>

      </div>

    <% end %>


    <!-- =========================
         マイページに戻る
    ========================== -->

    <div class="profile-edit-back">

      <%= link_to "← マイページに戻る",
        user_path(current_user),
        class: "profile-edit-back-button"
      %>

    </div>

  </div>


  <!-- =========================
       アカウント削除
  ========================== -->

  <div class="delete-account-card">

    <p class="delete-account-mini">
      Account
    </p>

    <h2>
      アカウントを削除する
    </h2>

    <p class="delete-account-text">
      アカウントを削除すると、元に戻すことはできません。
    </p>

    <%= button_to "アカウントを削除",
      registration_path(resource_name),
      data: {
        confirm: "本当にアカウントを削除しますか？",
        turbo_confirm: "本当にアカウントを削除しますか？"
      },
      method: :delete,
      class: "delete-account-button"
    %>

  </div>

</div>